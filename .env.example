# คัดลอกไฟล์นี้เป็น .env.local แล้วกรอกค่า (ไฟล์ .env.local ห้าม commit เข้า git)
#   Copy-Item .env.example .env.local
#
# รหัสผ่านฐานข้อมูลและ MS_CLIENT_SECRET ห้ามมี  $  #  "  '  `  \  และช่องว่าง และห้ามใส่เครื่องหมายคำพูดครอบค่า
# (แต่ละส่วนของระบบอ่านอักขระพวกนี้ต่างกัน) ใช้ตัวอักษร ตัวเลข และ ! @ % ^ & * - _ + = . , ? ~ แทนได้

# ---------- ฐานข้อมูล MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=promptpilot
# รหัสผ่านของผู้ใช้ MySQL (ผู้ใช้ชื่อเดียวกับ DB_NAME)
DB_PASS=
# ใส่เฉพาะเมื่อชื่อผู้ใช้ MySQL ไม่ใช่ชื่อเดียวกับ DB_NAME
DB_USER=

# ---------- เข้าสู่ระบบหน้า admin ด้วย Microsoft 365 (ดู DEPLOY.md ขั้นที่ 3.5) ----------
# ที่อยู่เว็บที่ผู้ใช้เปิดจริง (ไม่มี / ท้าย) — บน server ต้องเป็น https://
APP_URL=https://promptpilot.company.local
# จาก App registration ใน Microsoft Entra admin center
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# ผู้ดูแลระบบคนแรก: ชื่อ login Microsoft (UPN เช่น somchai@company.com) คั่นด้วย ,
# มีผลเฉพาะตอนที่ยังไม่มีผู้ดูแลระบบสักคน (ติดตั้งครั้งแรก หรือกู้คืนเมื่อผู้ดูแลระบบถูกปิดใช้หมด) — หลังจากนั้นทุกคนต้องรออนุมัติ
ADMIN_EMAILS=

# ---------- AI สำหรับสรุปข่าว (ต้องมีอย่างน้อย 1 ตัว) ----------
# ใช้ Claude ก่อน ถ้าเรียกไม่สำเร็จ (key ผิด / เครดิตหมด / ล่ม) จะใช้ OpenAI แทน
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# เปลี่ยนรุ่นโมเดล (ไม่ต้องใส่ก็ได้)
# ANTHROPIC_MODEL=claude-haiku-4-5
# OPENAI_MODEL=gpt-5.4-mini
