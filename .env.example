# คัดลอกไฟล์นี้เป็น .env.local แล้วกรอกค่า (ไฟล์ .env.local ห้าม commit เข้า git)
#   Copy-Item .env.example .env.local
#
# รหัสผ่านฐานข้อมูลห้ามมี  $  #  "  '  `  \  และช่องว่าง และห้ามใส่เครื่องหมายคำพูดครอบค่า
# (แต่ละส่วนของระบบอ่านอักขระพวกนี้ต่างกัน) ใช้ตัวอักษร ตัวเลข และ ! @ % ^ & * - _ + = . , ? แทนได้

# ---------- ฐานข้อมูล MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=promptpilot
# รหัสผ่านของผู้ใช้ MySQL (ผู้ใช้ชื่อเดียวกับ DB_NAME)
DB_PASS=
# ใส่เฉพาะเมื่อชื่อผู้ใช้ MySQL ไม่ใช่ชื่อเดียวกับ DB_NAME
DB_USER=

# บัญชีเข้าหน้า /admin ไม่ได้ตั้งที่นี่ — เก็บในตาราง users ของฐานข้อมูล
# สร้างคนแรกด้วย npm run user:create -- <username> (install.ps1 ถามให้ตอนติดตั้ง) แล้วเพิ่มคนอื่นในหน้า /admin/users

# ---------- AI สำหรับสรุปข่าว (ต้องมีอย่างน้อย 1 ตัว) ----------
# ใช้ Claude ก่อน ถ้าเรียกไม่สำเร็จ (key ผิด / เครดิตหมด / ล่ม) จะใช้ OpenAI แทน
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# เปลี่ยนรุ่นโมเดล (ไม่ต้องใส่ก็ได้)
# ANTHROPIC_MODEL=claude-haiku-4-5
# OPENAI_MODEL=gpt-5.4-mini
